---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import { helloWorld } from "./hello_world.js";
import ConnectFreighter from '../componentes/ConnectFreighter.astro';
import Counter from '../componentes/Counter.astro';
const greeting = "Hello, World!";
---

<html>
  <head>
    <title>Hello World</title>
  </head>
  <body>
    <h1>{greeting}</h1>
    <ConnectFreighter />
    <div id="counter-container" style="display: none;">
      <Counter />
    </div>
    <script type="module">
      import { helloWorld } from "/hello_world.js";
      import { loadedPublicKey } from "../stellar-wallets-kit";

      helloWorld();

      document.addEventListener("DOMContentLoaded", async () => {
        console.log("DOMContentLoaded event fired in index.astro");
        try {
          const publicKey = await loadedPublicKey();
          const counterContainer = document.getElementById("counter-container");

          if (publicKey) {
            console.log("Public key found:", publicKey);
            counterContainer.style.display = "block";
          }

          document.addEventListener("walletConnected", (event) => {
            console.log("walletConnected event fired");
            counterContainer.style.display = "block";
          });
        } catch (error) {
          console.error("Error during DOMContentLoaded:", error);
        }
      });
    </script>
  </body>
</html>